# Telegram
# Токен Telegram-бота, полученный у @BotFather.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Числовой Telegram ID владельца. Бот принимает управляющие запросы только от этого пользователя.
OWNER_TELEGRAM_ID=YOUR_TELEGRAM_ID

# Ollama Cloud
# Базовый адрес облачного API Ollama. Обычно менять не требуется.
OLLAMA_CLOUD_BASE_URL=https://ollama.com
# API-ключ Ollama Cloud со страницы https://ollama.com/settings/keys.
OLLAMA_CLOUD_API_KEY=YOUR_OLLAMA_CLOUD_API_KEY
# Разрешённые бесплатные облачные модели, которые бот показывает в меню /model.
OLLAMA_CLOUD_FREE_MODELS=gemma4:31b,gpt-oss:120b,gpt-oss:20b,nemotron-3-nano:30b,nemotron-3-super,nemotron-3-ultra

# Локальный API моделей
# Адрес собственного OpenAI-совместимого API, обычно с суффиксом /v1. Пустое значение отключает профиль.
LLM_LOCAL_BASE_URL=
# API-ключ собственного API. Если сервер не требует ключ, оставьте значение пустым.
LLM_LOCAL_API_KEY=YOUR_LLM_LOCAL_API_KEY

# Ограничения AI-агента
# Максимальное число последовательных шагов рассуждения и вызова инструментов на один запрос.
AGENT_MAX_STEPS=6
# Максимальное число инструментов, которые модель может вызвать за один шаг.
AGENT_MAX_TOOL_CALLS_PER_STEP=3
# Общий тайм-аут обработки одного запроса агентом, в секундах.
AGENT_TIMEOUT_SECONDS=300
# Максимальное время проверки одной отслеживаемой конференции, в секундах.
TRACKED_CHECK_TIMEOUT_SECONDS=300
# Максимальный размер контекста, передаваемого модели, в символах.
AGENT_MAX_CONTEXT_CHARS=24000
# Максимальный размер результата одного инструмента, возвращаемого модели, в символах.
AGENT_MAX_TOOL_RESULT_CHARS=12000

# Модели для ролей мультиагентного процесса. Пустое значение означает использование выбранной в боте модели.
# Модель координатора, который планирует и распределяет задачи.
AGENT_SUPERVISOR_MODEL=
# Модель исследователя, который ищет и извлекает сведения о конференциях.
AGENT_RESEARCH_MODEL=
# Модель проверяющего, который сверяет источники и подготовленные изменения.
AGENT_VERIFIER_MODEL=
# Резервная модель на случай ошибки основной модели роли.
AGENT_FALLBACK_MODEL=
# Включает долговечные многошаговые процессы поиска и проверки конференций.
AGENT_WORKFLOWS_ENABLED=true

# MCP
# Интерфейс встроенного MCP-сервера. 127.0.0.1 оставляет его доступным только внутри контейнера.
MCP_HOST=127.0.0.1
# TCP-порт встроенного MCP-сервера.
MCP_PORT=8765

# Хранилище и внешние сервисы
# Строка подключения к базе данных. Этот путь хранит SQLite-файл в подключённом Docker-томе /data.
DATABASE_URL=sqlite+aiosqlite:////data/conference_scout.db
# Адрес контейнера SearXNG, используемого для интернет-поиска.
SEARXNG_URL=http://searxng:8080
# Резервный сервис чтения страниц. Пустое значение отключает резервное чтение через Jina Reader.
READER_FALLBACK_URL=https://r.jina.ai
# Тайм-аут одного HTTP-запроса к сайту или поисковому сервису, в секундах.
REQUEST_TIMEOUT_SECONDS=20
# Максимальный объём загружаемой веб-страницы, в байтах.
MAX_PAGE_BYTES=2000000
# Максимальный объём текста страницы после очистки, в символах.
MAX_PAGE_TEXT_CHARS=50000

# Расписание поиска и мониторинга
# Час запуска общего цикла проверки и поиска по понедельникам, в часовой зоне APP_TIMEZONE.
DISCOVERY_HOUR=10
# Минимальный интервал между повторными проверками уже известного источника, в часах.
MONITORING_INTERVAL_HOURS=72
# Час ежедневной проверки напоминаний о дедлайнах, в часовой зоне APP_TIMEZONE.
REMINDER_HOUR=9
# За сколько дней до точного дедлайна присылать уведомления; 0 означает день дедлайна.
REMINDER_DAYS=30,14,7,3,1,0

# Фильтрация, время и журналирование
# Минимальная оценка релевантности кандидата от 0 до 1.
MIN_RELEVANCE_SCORE=0.5
# Часовая зона приложения в формате IANA; используется для расписаний и отображения времени.
APP_TIMEZONE=Europe/Moscow
# Уровень журналирования: DEBUG, INFO, WARNING, ERROR или CRITICAL.
LOG_LEVEL=INFO
