TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
OWNER_TELEGRAM_ID=YOUR_TELEGRAM_ID
# Ollama Cloud (key from https://ollama.com/settings/keys)
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_API_KEY=YOUR_OLLAMA_CLOUD_API_KEY
OLLAMA_CLOUD_FREE_MODELS=gemma4:31b,gpt-oss:120b,gpt-oss:20b,nemotron-3-nano:30b,nemotron-3-super,nemotron-3-ultra
# Local Ollama (inside Docker, host.docker.internal reaches the host)
OLLAMA_LOCAL_BASE_URL=http://host.docker.internal:11434
OLLAMA_LOCAL_API_KEY=
# Optional local OpenAI-compatible endpoint
LOCAL_OPENAI_BASE_URL=
LOCAL_OPENAI_API_KEY=
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS_PER_STEP=3
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_CONTEXT_CHARS=24000
AGENT_MAX_TOOL_RESULT_CHARS=12000
MCP_HOST=127.0.0.1
MCP_PORT=8765
DATABASE_URL=sqlite+aiosqlite:////data/conference_scout.db
SEARXNG_URL=http://searxng:8080
DISCOVERY_DAY=sun
DISCOVERY_HOUR=10
MONITORING_HOUR=9
REMINDER_DAYS=30,14,7,3,1
MIN_RELEVANCE_SCORE=0.5
APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
